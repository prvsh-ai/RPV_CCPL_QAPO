<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="Connect.QU.UII.Admin.Admin" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <link rel="stylesheet" href="../css/style.css" />
    <link rel="stylesheet" href="../css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css" />
    <%--    <link href="../css/NewFiles/font-awesome-min.css" rel="stylesheet" />
    <link href="../css/NewFiles/ionicons-min.css" rel="stylesheet" />--%>
    <%-- <link rel="stylesheet" href="../css/daterangepicker-bs3.css" />--%>
    <script src="../js/jQuery-2.1.4.min.js"></script>
    <script src="../js/pgwmodal.js" type="text/javascript"></script>
    <link rel="stylesheet" href="../css/all.css" />
    <%--      <link rel="stylesheet" href="../css/select2.min.css" />--%>
    <link rel="stylesheet" href="../css/AdminLTE.min.css" />
    <link rel="stylesheet" href="../css/skin-blue.min.css" />
    <%--<link href="//cdn.rawgit.com/Eonasdan/bootstrap-datetimepicker/e8bddc60e73c1ec2475f827be36e1957af72e2ea/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />--%>
    <link href="../css/NewFiles/bootstrap-datetimepicker.css" rel="stylesheet" />
    <link rel="stylesheet" href="../css/pgwmodal.css" />
</head>
<body class="hold-transition skin-blue sidebar-mini">
    <form id="Form1" name="formsubmit" runat="server">
        <div class="wrapper">
            <header class="main-header">
                <!-- Logo -->
                <%--<a href="index.html" class="logo">--%>
                <a href="CompanyDetails.aspx" class="logo">
                    <!-- mini logo for sidebar mini 50x50 pixels -->
                    <span class="logo-mini"><b>QU</b></span>
                    <!-- logo for regular state and mobile devices -->
                    <span class="logo-lg"><b>Enhanced </b>System</span>
                </a>
                <!-- Sidebar toggle button-->
                <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button"><span class="sr-only">Toggle navigation</span> </a>
                <!-- Header Navbar: style can be found in header.less -->
                <nav class="navbar navbar-static-top" role="navigation">
                    <div class="col-md-12 col-md-header">
                        <%--<a href="../Redirect.aspx" class="logo">--%>
                        <a href="CompanyDetails.aspx" class="logo">
                            <img src="../images/Connectlogo.JPG" width="115" alt="Logo" />
                            <!-- mini logo for sidebar mini 50x50 pixels -->
                            <span class="logo-mini"><b>Connect</b></span>
                            <!-- logo for regular state and mobile devices -->
                            <span class="logo-lg"><b>CCPL</b>System</span>
                        </a>
                        <!-- Navbar Right Menu -->
                        <div class="navbar-custom-menu">
                            <ul class="nav navbar-nav">
                                <li class="dropdown user user-menu">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown"><span class="pull-left">Welcome&nbsp;&nbsp;</span>
                                        <img src="../images/user.png" class="user-image" alt="User Image" />
                                        <span class="hidden-xs"><%=UserName %></span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <!-- User image -->
                                        <li class="user-header">
                                            <img src="../images/user.png" class="img-circle" alt="User Image" />
                                            <p>Name - <%=UserName %>  </p>
                                        </li>
                                        <!-- Menu Footer-->
                                        <li class="user-footer">
                                            <div class="pull-left"><a href="javascript:void(0)" data-toggle="dropdown" class="btn btn-default btn-flat">Close</a> </div>
                                            <div class="pull-right"><a href="../LogOff.aspx" class="btn btn-default btn-flat"><i class="fa fa-sign-out fa-fw"></i>Sign Out</a> </div>
                                        </li>
                                    </ul>
                                </li>
                                <li><a href="#"><i class="fa fa-calendar fa-fw"></i>Today : <span id="CurrentDateId"></span></a></li>
                                <li><a href="../LogOff.aspx"><i class="fa fa-sign-out fa-fw"></i>Sign Out </a></li>
                                <!-- User Account: style can be found in dropdown.less -->
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
            <!-- Left side column. contains the logo and sidebar -->
            <aside class="main-sidebar">
                <!-- sidebar: style can be found in sidebar.less -->
                <section class="sidebar">
                    <!-- Sidebar user panel -->
                    <ul class="sidebar-menu">
                        <li class="header">MAIN NAVIGATION</li>                        
                        <li><a href="Company.aspx"><i class="fa fa-edit"></i><span>Company</span></a> </li>
                        <li><a href="Register.aspx"><i class="fa fa-edit"></i><span>User Registration</span></a> </li>
                        <li><a href="Currency.aspx"><i class="fa fa-user"></i><span>Currency</span> </a></li>
                        <li><a href="Category.aspx"><i class="fa fa-user"></i><span>Category</span> </a></li>
                        <li><a href="Item.aspx"><i class="fa fa-user"></i><span>Item</span> </a></li>
                        <li><a href="Approval.aspx"><i class="fa fa-user"></i><span>Approval</span> </a></li>
                        <li><a href="Reports.aspx"><i class="fa fa-user"></i><span>Reports</span> </a></li>
                    </ul>
                </section>
                <!-- /.sidebar -->
            </aside>
            <!-- Content Wrapper. Contains page content -->
            <asp:ContentPlaceHolder ID="EAWarpper" runat="server">
            </asp:ContentPlaceHolder>
            <!-- /.content-wrapper -->
            <footer class="main-footer text-center">
                <strong>Copyright &copy; 2020 <a href="#">Connect Compusys Pvt Ltd</a>.</strong> All rights reserved.
            </footer>
        </div>
        <!-- ./wrapper -->
        <!-- jQuery 2.1.4 -->
        <script src="../js/bootstrap.min.js"></script>
        <script src="../js/select2.full.min.js"></script>
        <script src="../js/jquery.inputmask.js"></script>
        <script src="../js/jquery.inputmask.date.extensions.js"></script>
        <script src="../js/jquery.inputmask.extensions.js"></script>
        <%--<script src="//cdnjs.cloudflare.com/ajax/libs/moment.js/2.9.0/moment-with-locales.js"></script>
        <script src="//cdn.rawgit.com/Eonasdan/bootstrap-datetimepicker/e8bddc60e73c1ec2475f827be36e1957af72e2ea/src/js/bootstrap-datetimepicker.js"></script>--%>
        <script src="../js/NewFiles/moment-with-locales.js"></script>
        <script src="../js/NewFiles/bootstrap-datetimepicker.js"></script>
        <script src="../js/jquery.slimscroll.min.js"></script>
        <script src="../js/jquery.slimscroll.min.js"></script>
        <script src="../js/icheck.min.js"></script>
        <%-- <script src="../js/fastclick.min.js"></script>--%>
        <script src="../js/app.min.js"></script>
        <%--<script src="https://cdn.jsdelivr.net/jquery.validation/1.15.1/jquery.validate.min.js"></script>--%>
        <script src="../js/NewFiles/jquery-validate-min.js"></script>
        <%--for multiselect--%>
        <%--<link href="https://select2.github.io/dist/css/select2.min.css" type="text/css" rel="stylesheet" />--%>
        <link href="../css/NewFiles/select2-min.css" rel="stylesheet" />
        <!-- Page script -->
        <script>
            $(document).ready(function () {
                // window.history.forward(1);
                $(document).ajaxError(function (xhr, props) {
                    if (props.status === 401) {
                        alert('Your Session has been Expired. Redirecting to Login Page');
                        location.reload();
                    }
                });
                var dt = new Date();
                var Days;// = //dt.getDate();
                var Months;//= //dt.getMonth() + 1;
                var RealMonths = dt.getMonth() + 1;;
                if (dt.getDate() < 10) {
                    Days = '0' + dt.getDate();
                }
                else {
                    Days = dt.getDate();
                }
                if (dt.getMonth() + 1 < 10) {
                    Months = '0' + RealMonths;
                }
                else {
                    Months = RealMonths;
                }
                var date = Months + "/" + Days + "/" + dt.getFullYear();
                $('#CurrentDateId').text(date);
            });
        </script>
    </form>
</body>
</html>

